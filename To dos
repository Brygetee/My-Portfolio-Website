
@media (max-width: 480px) and (orientation: portrait) {

    .content,
    .column-sections {
        overflow-y: auto !important;
        border: 5px solid;
    }

    .content {
        width: 83vw;
    }

    .column-sections {
        flex-direction: column;
        gap: 1rem;
        position: relative;
        align-items: center;
    }


    .column-sections > header {
        position: static;
        transform: none;
        order: 1;
    }

    #about-heading {
        font-size: 3rem;
        white-space: nowrap;
        margin: 1rem 0 0;
        border: 2px solid black;
    }

    /* Cartoon + speech bubble */

    .third_column {
        order: 2;
        width: 90%;
        height: fit-content;
        margin-bottom: 2rem;
    }

    .greeting {
        width: 90%;
        height: fit-content;
    }

    #cartoon {
        width: 90%;

    }


    /* Technical Skills */

    .second-column {
        order: 3;
        width: 90%;
        height: fit-content;
        padding-top: 0;
    }

    .programming-skills {
        width: 95%;
        height: fit-content;
        padding: 6rem 0;
    }

    /* Education */

    .first-column {
        order: 4;
        width: 90%;
        height: fit-content;
    }

    .web-dev {
        flex-wrap: wrap;
    }

    .second-column h2,
    .first-column h2 {
        font-size: 1.5rem;
        padding: 0.15em 1.15em;
    }

    #flower-decoration-1,
    #flower-decoration-2 {
        color: transparent;
    }

    /* Tabs */

    .tabs {
        flex-direction: row;
        transform: rotate(90deg);
        justify-content: center;
        align-items: flex-start;
        position: absolute;
        right: -25%;
        top: 26%;
        margin-top: 5px;
    }

    .tab {
        border: 5px solid;
        font-size: 1.1rem;
        padding: 10px;
        margin: 0;
        width: fit-content;
    }
}
/*----------------contact page--------------------*/
.content.contact-content {
    border: 5px solid var(--dark-purple);
    padding: 10%;
    overflow-y: scroll;
}
.contact-page{
    flex-direction: column;
    align-items: center;
    width: 100%;
    border: none;

}

.post-card {
    width: 100%;
    padding: 10%;
    margin-top: 0%;

}
#contact-page-h1{
    font-size: 3.5rem;
    color: var(--dark-pink);
    text-shadow: 2px 2px 2px var(--dark-purple);
    position: static;
}

.address-lines{
    color: transparent;
    position: absolute;
    top: 50%;
}

#stamp{
    font-size: 1.5rem;
    height: 15%;
    width: 15%;
}